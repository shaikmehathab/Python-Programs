   "source": [
    "#NET SALARY CALCULATER\n",
    "basic = float(input(\"Enter Basic Salary: \"))\n",
    "hra = basic * 20 / 100\n",
    "da = basic * 50 / 100\n",
    "gross = basic + hra + da\n",
    "print(\"Gross Salary =\", gross)\n",
    "tax=gross*10/100\n",
    "net=gross-tax"
   ]
  }
